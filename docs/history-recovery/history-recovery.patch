+}
+
+export interface RecoveryBatch {
+  requestId: string;
+  provenance: RecoveryProvenance;
+  messages: SelectedRecoveryMessage[];
+}
+
+export interface RoutingPlan {
+  passthroughHistorySet: boolean;
+  historyPayload?: any;
+  recoveryBatches: RecoveryBatch[];
+  liveUpsert: { messages: any[]; type?: unknown; requestId?: unknown } | null;
+}
+
+export interface AuditEntry {
+  at: number;
+  requestId: string | null;
+  event: string;
+  status: string;
+  counts: RecoveryCounts;
+}
+
+export interface NormalizedStoredMessage {
+  key: {
+    id: string;
+    remoteJid: string;
+    fromMe: boolean;
+    participant?: string;
+  };
+  pushName?: string | null;
+  message: Record<string, unknown>;
+  contextInfo?: unknown;
+  messageType: string;
+  messageTimestamp: number;
+  instanceId: string;
+  source?: string;
+}
+
+export interface StoredRecoveryRow {
+  key: {
+    id: string;
+    remoteJid: string;
+    fromMe: boolean;
+    participant?: string;
+  };
+  pushName: string | null;
+  status: typeof HISTORY_RECOVERY_STORED_STATUS;
+  message: Record<string, unknown>;
+  contextInfo?: unknown;
+  messageType: string;
+  messageTimestamp: number;
+  instanceId: string;
+  source: string;
+}
+
+export interface PersistTally {
+  persisted: number;
+  duplicates: number;
+  skippedWithoutBody: number;
+  persistenceDisabled: boolean;
+  error?: string;
+}
