+/**
+ * Bounds for opt-in, per-conversation on-demand history recovery.
+ * Baileys 7.0.0-rc.9 fetchMessageHistory sends HistorySyncOnDemandRequest.
+ * The companion asks the primary phone for messages OLDER than the anchor.
+ */
+export const HISTORY_RECOVERY_LIMITS = {
+  minCount: 1,
+  maxCount: 50,
+  minPage: 1,
+  maxPage: 20,
+  minTimeoutMs: 5_000,
+  maxTimeoutMs: 120_000,
+  defaultTimeoutMs: 45_000,
+  minIntervalMs: 15_000,
+  maxPerHour: 30,
+  correlationTtlMs: 24 * 60 * 60 * 1000,
+  maxTrackedRequests: 50,
+  maxAuditEntries: 100,
+} as const;
+
+/** proto.HistorySync.HistorySyncType.ON_DEMAND in Baileys 7.0.0-rc.9. */
+export const ON_DEMAND_SYNC_TYPE = 6;
+
+export const HISTORY_RECOVERY_PROVENANCE = 'on-demand-history';
+
+/**
+ * Stored Message.status for recovered rows.
+ * DELIVERY_ACK is what this codebase counts as unread, so recovered rows must not use it.
+ */
+export const HISTORY_RECOVERY_STORED_STATUS = 'HISTORY';
+
+export const ANCHOR_MIN_UNIX_SECONDS = 1_000_000_000;
+export const ANCHOR_MAX_UNIX_SECONDS = 4_000_000_000;
+export const MILLISECOND_TIMESTAMP_FLOOR = 1_000_000_000_000;
+
+export const BASELINE = {
+  evolution: '2.3.7',
+  evolutionCommit: 'cd800f2976e1e5b682fbf86a01ee4d85ae61f370',
+  baileys: '7.0.0-rc.9',
+  direction: 'older-than-anchor',
+} as const;
diff --git a/src/api/services/history-recovery/history-recovery.coordinator.ts b/src/api/services/history-recovery/history-recovery.coordinator.ts
new file mode 100644
index 00000000..6f178adc
--- /dev/null
+++ b/src/api/services/history-recovery/history-recovery.coordinator.ts
@@ -0,0 +1,525 @@
+import { randomUUID } from 'crypto';
+
+import { BASELINE, HISTORY_RECOVERY_LIMITS } from './history-recovery.constants';
+import {
+  addCounts,
+  buildProvenance,
+  emptyCounts,
+  isOnDemandSyncType,
+  selectRecoverableMessages,
+  validateRecoveryRequest,
+} from './history-recovery.policy';
+import {
+  AuditEntry,
+  HistorySetEvent,
+  NormalizedRecoveryRequest,
+  PublicRecoveryView,
+  RecoveryBatch,
+  RecoveryRecord,
+  RecoveryRequestInput,
+  RecoveryStatus,
+  RoutingPlan,
+} from './history-recovery.types';
+
+const WATCHER_SQL =
+  "COALESCE(message->'_evolutionRecovery'->>'provenance', '') <> 'on-demand-history' AND COALESCE(status, '') <> 'HISTORY'";
+
+const VERIFICATION_STATEMENT =
+  'Counts reflect events observed by this process only. They are not evidence that a missed outage window was recovered on a real WhatsApp device.';
+
+function inFlight(status: RecoveryRecord['status']): boolean {
+  return status === 'reserved' || status === 'accepted';
+}
+
+export class HistoryRecoveryCoordinator {
+  private readonly records = new Map<string, RecoveryRecord>();
+  private readonly bySession = new Map<string, string>();
+  private readonly submittedAt: number[] = [];
+  private lastSubmittedAt = 0;
+  private readonly auditLog: AuditEntry[] = [];
+
+  constructor(private readonly requestIdFactory: () => string = () => `hr_${randomUUID()}`) {}
+
+  public prepare(
+    input: RecoveryRequestInput,
+    now: number,
+  ): { ok: true; record: RecoveryRecord } | { ok: false; view: PublicRecoveryView } {
+    const validated = validateRecoveryRequest(input);
+    if (validated.ok === false) {
+      return { ok: false, view: this.rejectedView(validated.errors) };
+    }
+
+    const value = validated.value;
+    if (value.dryRun) {
+      const record = this.makeRecord(value, now, 'dry-run', 200);
+      this.remember(record);
+      this.audit(record, 'dry-run', now);
+      return { ok: true, record };
+    }
+
+    const active = this.activeRecord();
+    if (active) {
+      return {
+        ok: false,
+        view: this.conflictView(active.requestId),
+      };
+    }
+
+    this.pruneSubmitted(now);
+    if (this.lastSubmittedAt > 0 && now - this.lastSubmittedAt < HISTORY_RECOVERY_LIMITS.minIntervalMs) {
+      return { ok: false, view: this.rateLimitedView('Aguarde o intervalo mínimo antes de outra recuperação.') };
+    }
+    if (this.submittedAt.length >= HISTORY_RECOVERY_LIMITS.maxPerHour) {
+      return { ok: false, view: this.rateLimitedView('Limite horário de recuperações desta instância foi atingido.') };
+    }
+
+    const record = this.makeRecord(value, now, 'reserved', 202);
+    this.remember(record);
+    this.audit(record, 'reserve', now);
+    return { ok: true, record };
+  }
+
+  public markSubmitted(requestId: string, sessionId: string, now: number): void {
+    const record = this.records.get(requestId);
+    if (!record || record.status !== 'reserved') {
+      return;
+    }
+    record.status = 'accepted';
+    record.httpStatus = 202;
+    record.peerDataRequestSessionId = sessionId;
+    record.submittedAt = now;
+    record.deadlineAt = now + record.timeoutMs;
+    this.bySession.set(sessionId, requestId);
+    this.lastSubmittedAt = now;
+    this.submittedAt.push(now);
+    this.audit(record, 'submit', now);
+  }
+
+  public abort(requestId: string, status: RecoveryStatus, httpStatus: number, error: string, now: number): void {
+    const record = this.records.get(requestId);
+    if (!record) {
+      return;
+    }
+    record.status = status;
+    record.httpStatus = httpStatus;
+    record.lastError = error;
+    this.audit(record, status, now);
+  }
+
+  public expire(now: number): void {
+    for (const record of this.records.values()) {
+      if (record.status === 'accepted' && record.deadlineAt !== undefined && now >= record.deadlineAt) {
+        record.status = 'timeout';
+        record.httpStatus = 200;
+        this.audit(record, 'timeout', now);
+      }
+    }
+  }
+
+  public planEvents(events: { historySet?: any; upsert?: any }, now: number): RoutingPlan {
+    this.expire(now);
+    const plan: RoutingPlan = {
+      passthroughHistorySet: false,
+      recoveryBatches: [],
+      liveUpsert: null,
+    };
+
+    if (events.historySet) {
+      if (!isOnDemandSyncType(events.historySet.syncType)) {
+        plan.passthroughHistorySet = true;
+        plan.historyPayload = events.historySet;
+      } else {
+        const batch = this.consumeHistory(events.historySet, now);
+        if (batch) {
+          plan.recoveryBatches.push(batch);
+        }
+      }
+    }
+
+    if (events.upsert) {
+      const sessionId =
+        events.upsert.requestId === undefined || events.upsert.requestId === null
+          ? ''
+          : String(events.upsert.requestId);
+      const requestId = sessionId ? this.bySession.get(sessionId) : undefined;
+      if (requestId && this.records.has(requestId)) {
+        const batch = this.consumeMessages(requestId, events.upsert.messages, now, 'messages.upsert');
+        if (batch) {
+          plan.recoveryBatches.push(batch);
+        }
+      } else {
+        plan.liveUpsert = {
+          messages: events.upsert.messages ?? [],
+          type: events.upsert.type,
+          requestId: events.upsert.requestId,
+        };
+      }
+    }
+
+    return plan;
+  }
+
+  public notePersistence(
+    requestId: string,
+    tally: {
+      persisted: number;
+      duplicates: number;
+      skippedWithoutBody: number;
+      persistenceDisabled: boolean;
+      error?: string;
+    },
+    now: number,
+  ): void {
+    const record = this.records.get(requestId);
+    if (!record) {
+      return;
+    }
+    record.counts.persisted += tally.persisted;
+    record.counts.duplicates += tally.duplicates;
+    record.counts.skippedWithoutBody += tally.skippedWithoutBody;
+    record.persistenceDisabled = tally.persistenceDisabled;
+    if (tally.error) {
+      record.lastError = tally.error;
+    }
+    this.audit(record, 'persist', now);
+  }
+
+  public get(requestId: string, now: number): RecoveryRecord | undefined {
+    this.expire(now);
+    return this.records.get(requestId);
+  }
+
+  public auditEntries(): AuditEntry[] {
+    return this.auditLog.map((entry) => ({ ...entry, counts: { ...entry.counts } }));
+  }
+
+  public toPublic(record: RecoveryRecord): PublicRecoveryView {
+    const status = record.status === 'reserved' ? 'accepted' : record.status;
+    const view: PublicRecoveryView = {
+      requestId: record.requestId,
+      status,
+      httpStatus: record.httpStatus,
+      dryRun: record.dryRun,
+      direction: 'older-than-anchor',
+      baseline: {
+        evolution: BASELINE.evolution,
+        evolutionCommit: BASELINE.evolutionCommit,
+        baileys: BASELINE.baileys,
+      },
+      remoteJid: record.remoteJid,
+      anchor: {
+        id: record.anchor.id,
+        fromMe: record.anchor.fromMe,
+        timestampSeconds: record.anchor.timestampSeconds,
+      },
+      limits: {
+        count: record.count,
+        page: record.page,
+        timeoutMs: record.timeoutMs,
+        maxCount: HISTORY_RECOVERY_LIMITS.maxCount,
+        maxPage: HISTORY_RECOVERY_LIMITS.maxPage,
+        minTimeoutMs: HISTORY_RECOVERY_LIMITS.minTimeoutMs,
+        maxTimeoutMs: HISTORY_RECOVERY_LIMITS.maxTimeoutMs,
+      },
+      counts: { ...record.counts },
+      persistence: this.persistenceView(record.persistenceDisabled),
+      delivery: this.deliveryView(),
+      integration: this.integrationView(),
+      verification: {
+        liveWhatsAppExecution: false,
+        statement: VERIFICATION_STATEMENT,
+      },
+      protocol: this.protocolView(),
+    };
+    if (record.dryRun) {
+      view.wouldSend = {
+        method: 'fetchMessageHistory',
+        count: record.count,
+        oldestMsgTimestampMs: record.anchor.timestampSeconds * 1000,
+        oldestMsgFromMe: record.anchor.fromMe,
+        oldestMsgId: record.anchor.id,
+        chatJid: record.remoteJid,
+      };
+    }
+    if (record.lastError) {
+      view.error = record.lastError;
+    }
+    return view;
+  }
+
+  private consumeHistory(event: HistorySetEvent, now: number): RecoveryBatch | null {
+    const sessionId =
+      event.peerDataRequestSessionId === undefined || event.peerDataRequestSessionId === null
+        ? ''
+        : String(event.peerDataRequestSessionId);
+    let requestId = sessionId ? this.bySession.get(sessionId) : undefined;
+    if (!requestId) {
+      const candidate = this.singleAttributableRecord(now);
+      requestId = candidate?.requestId;
+      if (requestId && sessionId) {
+        this.bySession.set(sessionId, requestId);
+        const record = this.records.get(requestId);
+        if (record && !record.peerDataRequestSessionId) {
+          record.peerDataRequestSessionId = sessionId;
+        }
+      }
+    }
+    if (!requestId || !this.records.has(requestId)) {
+      this.auditLog.push({
+        at: now,
+        requestId: null,
+        event: 'unsolicited-on-demand',
+        status: 'ignored',
+        counts: { ...emptyCounts(), protocolMessages: event.messages?.length ?? 0 },
+      });
+      this.trimAudit();
+      return null;
+    }
+    return this.consumeMessages(requestId, event.messages, now, 'messaging-history.set');
+  }
+
+  private consumeMessages(
+    requestId: string,
+    messages: HistorySetEvent['messages'],
+    now: number,
+    eventName: string,
+  ): RecoveryBatch | null {
+    const record = this.records.get(requestId);
+    if (!record || !this.correlatable(record, now)) {
+      return null;
+    }
+    const selection = selectRecoverableMessages(messages, record);
+    addCounts(record.counts, selection.counts);
+    const wasTimeout = record.status === 'timeout';
+    if (record.counts.acceptedForStorage === 0) {
+      record.status = wasTimeout ? 'timeout' : 'empty';
+    } else if (wasTimeout) {
+      record.status = 'late-received';
+    } else if (record.counts.acceptedForStorage >= record.count) {
+      record.status = 'received';
+    } else {
+      record.status = 'partial';
+    }
+    record.httpStatus = 200;
+    this.audit(record, eventName, now);
+    return {
+      requestId,
+      provenance: buildProvenance(record, now),
+      messages: selection.selected,
+    };
+  }
+
+  private correlatable(record: RecoveryRecord, now: number): boolean {
+    if (record.dryRun || record.status === 'reserved' || record.status === 'rejected') {
+      return false;
+    }
+    const started = record.submittedAt ?? record.createdAt;
+    return now - started <= HISTORY_RECOVERY_LIMITS.correlationTtlMs;
+  }
+
+  private singleAttributableRecord(now: number): RecoveryRecord | undefined {
+    const candidates = [...this.records.values()].filter((record) => {
+      if (!this.correlatable(record, now)) {
+        return false;
+      }
+      return record.status === 'accepted' || record.status === 'timeout' || record.status === 'partial';
+    });
+    const accepted = candidates.filter((record) => record.status === 'accepted');
+    if (accepted.length === 1) {
+      return accepted[0];
+    }
+    if (accepted.length === 0 && candidates.length === 1) {
+      return candidates[0];
+    }
+    return undefined;
+  }
+
+  private activeRecord(): RecoveryRecord | undefined {
+    return [...this.records.values()].find((record) => inFlight(record.status));
+  }
+
+  private makeRecord(
+    value: NormalizedRecoveryRequest,
+    now: number,
+    status: RecoveryRecord['status'],
+    httpStatus: number,
+  ): RecoveryRecord {
+    return {
+      requestId: this.requestIdFactory(),
+      peerDataRequestSessionId: null,
+      remoteJid: value.remoteJid,
+      anchor: value.anchor,
+      count: value.count,
+      page: value.page,
+      notBeforeTimestamp: value.notBeforeTimestamp,
+      notAfterTimestamp: value.notAfterTimestamp,
+      timeoutMs: value.timeoutMs,
+      dryRun: value.dryRun,
+      status,
+      httpStatus,
+      createdAt: now,
+      counts: emptyCounts(),
+      persistenceDisabled: false,
+    };
+  }
+
+  private remember(record: RecoveryRecord): void {
+    this.records.set(record.requestId, record);
+    this.trimRecords();
+  }
+
+  private trimRecords(): void {
+    const terminal = [...this.records.values()].filter((record) => !inFlight(record.status));
+    while (this.records.size > HISTORY_RECOVERY_LIMITS.maxTrackedRequests && terminal.length > 0) {
+      const oldest = terminal.shift();
+      if (!oldest) {
+        break;
+      }
+      this.records.delete(oldest.requestId);
+      if (oldest.peerDataRequestSessionId) {
+        this.bySession.delete(oldest.peerDataRequestSessionId);
+      }
+    }
+  }
+
+  private pruneSubmitted(now: number): void {
+    const cutoff = now - 60 * 60 * 1000;
+    while (this.submittedAt.length > 0 && this.submittedAt[0] < cutoff) {
+      this.submittedAt.shift();
+    }
+  }
+
+  private audit(record: RecoveryRecord, event: string, now: number): void {
+    this.auditLog.push({
+      at: now,
+      requestId: record.requestId,
+      event,
+      status: record.status,
+      counts: { ...record.counts },
+    });
+    this.trimAudit();
+  }
+
+  private trimAudit(): void {
+    while (this.auditLog.length > HISTORY_RECOVERY_LIMITS.maxAuditEntries) {
+      this.auditLog.shift();
+    }
+  }
+
+  private persistenceView(persistenceDisabled: boolean): PublicRecoveryView['persistence'] {
+    return {
+      table: 'Message',
+      storedStatus: 'HISTORY',
+      provenancePath: 'message._evolutionRecovery.provenance',
+      provenanceValue: 'on-demand-history',
+      idempotent: true,
+      preserves: ['messageTimestamp', 'key.fromMe', 'key.id', 'key.remoteJid'],
+      persistenceDisabled,
+    };
+  }
+
+  private deliveryView(): PublicRecoveryView['delivery'] {
+    return {
+      messagesUpsertWebhook: false,
+      messagesSetWebhook: false,
+      chatbotEmit: false,
+      chatwootEvent: false,
+      readReceipts: false,
+      unreadCounter: false,
+      autosend: false,
+    };
+  }
+
+  private integrationView(): PublicRecoveryView['integration'] {
+    return {
+      externalDbPoller: {
+        status: 'BLOCKED',
+        requiredSqlExclusion: WATCHER_SQL,
+        reason:
+          'Recovered rows are inserted into Message with their original timestamps. A database poller that treats every new row as a live message will misclassify them until it excludes this provenance and HISTORY status. That watcher is not in this repository.',
+      },
+    };
+  }
+
+  private protocolView(): PublicRecoveryView['protocol'] {
+    return {
+      method: 'baileys.fetchMessageHistory',
+      responseEvents: ['messaging-history.set', 'messages.upsert'],
+      notes: [
+        'The Baileys 7.0.0-rc.9 request asks for messages older than the anchor. It does not fetch newer messages.',
+        'WhatsApp may return no data, a partial page, or nothing before the timeout. This API does not invent message bodies.',
+        'A completed or partial status only means a correlated protocol batch was observed. It does not mean the outage window is complete.',
+        'Page is a label for the caller. Each invocation performs one fetch. The next older page requires a new explicit call with a new anchor.',
+        'syncFullHistory is not changed. There is no automatic catch-up scan.',
+      ],
+    };
+  }
+
+  private rejectedView(errors: string[]): PublicRecoveryView {
+    return {
+      status: 'rejected',
+      httpStatus: 400,
+      dryRun: false,
+      direction: 'older-than-anchor',
+      baseline: { evolution: BASELINE.evolution, evolutionCommit: BASELINE.evolutionCommit, baileys: BASELINE.baileys },
+      limits: {
+        maxCount: HISTORY_RECOVERY_LIMITS.maxCount,
+        maxPage: HISTORY_RECOVERY_LIMITS.maxPage,
+        minTimeoutMs: HISTORY_RECOVERY_LIMITS.minTimeoutMs,
+        maxTimeoutMs: HISTORY_RECOVERY_LIMITS.maxTimeoutMs,
+      },
+      counts: emptyCounts(),
+      persistence: this.persistenceView(false),
+      delivery: this.deliveryView(),
+      integration: this.integrationView(),
+      verification: { liveWhatsAppExecution: false, statement: VERIFICATION_STATEMENT },
+      protocol: this.protocolView(),
+      errors,
+      error: errors[0],
+    };
+  }
+
+  private conflictView(activeRequestId: string): PublicRecoveryView {
+    const view = this.rejectedView(['Já existe uma recuperação em andamento para esta instância.']);
+    view.status = 'conflict';
+    view.httpStatus = 409;
+    view.activeRequestId = activeRequestId;
+    return view;
+  }
+
+  private rateLimitedView(message: string): PublicRecoveryView {
+    const view = this.rejectedView([message]);
+    view.status = 'rate-limited';
+    view.httpStatus = 429;
+    return view;
+  }
+}
+
+export function safeProtocolError(error: unknown): string {
+  const message = error instanceof Error ? error.message : 'Falha ao solicitar histórico sob demanda.';
+  return message.replace(/\s+/g, ' ').slice(0, 200);
+}
+
+export async function applyBaileysEventRouting(
+  plan: RoutingPlan,
+  handlers: {
+    passthroughHistory: (payload: any) => Promise<void>;
+    persistRecovery: (batch: RecoveryBatch) => Promise<void>;
+    liveUpsert: (payload: { messages: any[]; type?: unknown; requestId?: unknown }) => Promise<void>;
+    onRecoveryError?: (error: unknown) => void;
+  },
+): Promise<void> {
+  if (plan.liveUpsert) {
+    await handlers.liveUpsert(plan.liveUpsert);
+  }
+  if (plan.passthroughHistorySet && plan.historyPayload) {
+    await handlers.passthroughHistory(plan.historyPayload);
+  }
+  for (const batch of plan.recoveryBatches) {
+    try {
+      await handlers.persistRecovery(batch);
+    } catch (error) {
+      handlers.onRecoveryError?.(error);
+    }
+  }
+}
diff --git a/src/api/services/history-recovery/history-recovery.policy.ts b/src/api/services/history-recovery/history-recovery.policy.ts
new file mode 100644
index 00000000..49e73d14
--- /dev/null
+++ b/src/api/services/history-recovery/history-recovery.policy.ts
@@ -0,0 +1,349 @@
+import {
+  ANCHOR_MAX_UNIX_SECONDS,
+  ANCHOR_MIN_UNIX_SECONDS,
+  HISTORY_RECOVERY_LIMITS,
+  HISTORY_RECOVERY_PROVENANCE,
+  HISTORY_RECOVERY_STORED_STATUS,
+  MILLISECOND_TIMESTAMP_FLOOR,
+  ON_DEMAND_SYNC_TYPE,
+} from './history-recovery.constants';
+import {
+  InboundRecoveryMessage,
+  NormalizedRecoveryRequest,
+  RecoveryAnchorInput,
+  RecoveryCounts,
+  RecoveryProvenance,
+  RecoveryRecord,
+  RecoveryRequestInput,
+  SelectedRecoveryMessage,
+  StoredRecoveryRow,
+} from './history-recovery.types';
+
+const JID_PATTERN =
+  /^(?:[0-9]{6,20}@s\.whatsapp\.net|[0-9]{6,30}(?:-[0-9]{6,30})?@g\.us|[0-9]{6,20}@lid|synthetic-[a-z0-9-]{1,40}@(?:s\.whatsapp\.net|g\.us|lid))$/;
+
+const MESSAGE_ID_PATTERN = /^[A-Za-z0-9]{6,128}$/;
+
+export function emptyCounts(): RecoveryCounts {
+  return {
+    protocolMessages: 0,
+    acceptedForStorage: 0,
+    persisted: 0,
+    duplicates: 0,
+    skippedWithoutBody: 0,
+    filteredByWindow: 0,
+    ignoredOtherChat: 0,
+    newerOrEqualToAnchor: 0,
+  };
+}
+
+export function isOnDemandSyncType(syncType: unknown): boolean {
+  return syncType === ON_DEMAND_SYNC_TYPE || syncType === 'ON_DEMAND' || syncType === '6';
+}
+
+export function withoutRecoveredHistory<T extends Record<string, unknown>>(where: T): T & { NOT: { status: string } } {
+  return { ...where, NOT: { status: HISTORY_RECOVERY_STORED_STATUS } };
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === 'object' && !Array.isArray(value);
+}
+
+function readInteger(value: unknown): number | null {
+  if (typeof value !== 'number' || !Number.isFinite(value) || !Number.isInteger(value)) {
+    return null;
+  }
+  return value;
+}
+
+function validateAnchorTimestamp(value: unknown, errors: string[]): number | null {
+  const timestamp = readInteger(value);
+  if (timestamp === null) {
+    errors.push('A âncora precisa de timestamp inteiro em segundos Unix.');
+    return null;
+  }
+  if (timestamp >= MILLISECOND_TIMESTAMP_FLOOR) {
+    errors.push('A âncora deve usar timestamp em segundos Unix, não milissegundos.');
+    return null;
+  }
+  if (timestamp < ANCHOR_MIN_UNIX_SECONDS || timestamp > ANCHOR_MAX_UNIX_SECONDS) {
+    errors.push('O timestamp da âncora está fora do intervalo aceito de segundos Unix.');
+    return null;
+  }
+  return timestamp;
+}
+
+function validateOptionalWindow(value: unknown, label: string, errors: string[]): number | undefined {
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  const timestamp = readInteger(value);
+  if (timestamp === null || timestamp >= MILLISECOND_TIMESTAMP_FLOOR) {
+    errors.push(`${label} deve ser segundos Unix, não milissegundos.`);
+    return undefined;
+  }
+  if (timestamp < ANCHOR_MIN_UNIX_SECONDS || timestamp > ANCHOR_MAX_UNIX_SECONDS) {
+    errors.push(`${label} está fora do intervalo aceito.`);
+    return undefined;
+  }
+  return timestamp;
+}
+
+export function validateRecoveryRequest(
+  input: RecoveryRequestInput,
+): { ok: true; value: NormalizedRecoveryRequest } | { ok: false; errors: string[] } {
+  const errors: string[] = [];
+  const remoteJid = typeof input?.remoteJid === 'string' ? input.remoteJid : '';
+  if (!JID_PATTERN.test(remoteJid)) {
+    errors.push('remoteJid deve ser um JID de usuário, grupo, lid ou um identificador sintético de teste.');
+  }
+
+  const anchor = (input?.anchor ?? {}) as RecoveryAnchorInput;
+  const anchorId = typeof anchor.id === 'string' ? anchor.id : '';
+  if (!MESSAGE_ID_PATTERN.test(anchorId)) {
+    errors.push('anchor.id deve ser o identificador real da mensagem âncora, sem texto livre.');
+  }
+  if (typeof anchor.fromMe !== 'boolean') {
+    errors.push('anchor.fromMe deve ser booleano. A recuperação não infere a direção.');
+  }
+  const anchorRemote =
+    typeof anchor.remoteJid === 'string' && anchor.remoteJid.length > 0 ? anchor.remoteJid : remoteJid;
+  if (anchorRemote !== remoteJid) {
+    errors.push('anchor.remoteJid deve ser o mesmo remoteJid da conversa solicitada.');
+  }
+  if (anchor.remoteJid !== undefined && anchor.remoteJid !== null && !JID_PATTERN.test(String(anchor.remoteJid))) {
+    errors.push('anchor.remoteJid possui formato inválido.');
+  }
+  const timestampSeconds = validateAnchorTimestamp(anchor.timestamp, errors);
+
+  const count = readInteger(input?.count);
+  if (count === null || count < HISTORY_RECOVERY_LIMITS.minCount || count > HISTORY_RECOVERY_LIMITS.maxCount) {
+    errors.push(
+      `count deve ser um inteiro entre ${HISTORY_RECOVERY_LIMITS.minCount} e ${HISTORY_RECOVERY_LIMITS.maxCount}.`,
+    );
+  }
+
+  const page = input?.page === undefined || input?.page === null ? 1 : readInteger(input.page);
+  if (page === null || page < HISTORY_RECOVERY_LIMITS.minPage || page > HISTORY_RECOVERY_LIMITS.maxPage) {
+    errors.push(
+      `page deve ser um inteiro entre ${HISTORY_RECOVERY_LIMITS.minPage} e ${HISTORY_RECOVERY_LIMITS.maxPage}.`,
+    );
+  }
+
+  const notBeforeTimestamp = validateOptionalWindow(input?.notBeforeTimestamp, 'notBeforeTimestamp', errors);
+  const notAfterTimestamp = validateOptionalWindow(input?.notAfterTimestamp, 'notAfterTimestamp', errors);
+  if (notBeforeTimestamp !== undefined && notAfterTimestamp !== undefined && notBeforeTimestamp > notAfterTimestamp) {
+    errors.push('notBeforeTimestamp não pode ser maior que notAfterTimestamp.');
+  }
+  if (timestampSeconds !== null && notBeforeTimestamp !== undefined && notBeforeTimestamp >= timestampSeconds) {
+    errors.push(
+      'A recuperação sob demanda só devolve mensagens mais antigas que a âncora. A janela informada está inteiramente depois da âncora.',
+    );
+  }
+
+  if (input?.dryRun !== undefined && input?.dryRun !== null && typeof input.dryRun !== 'boolean') {
+    errors.push('dryRun deve ser booleano.');
+  }
+
+  const timeoutMs =
+    input?.timeoutMs === undefined || input?.timeoutMs === null
+      ? HISTORY_RECOVERY_LIMITS.defaultTimeoutMs
+      : readInteger(input.timeoutMs);
+  if (
+    timeoutMs === null ||
+    timeoutMs < HISTORY_RECOVERY_LIMITS.minTimeoutMs ||
+    timeoutMs > HISTORY_RECOVERY_LIMITS.maxTimeoutMs
+  ) {
+    errors.push(
+      `timeoutMs deve ser um inteiro entre ${HISTORY_RECOVERY_LIMITS.minTimeoutMs} e ${HISTORY_RECOVERY_LIMITS.maxTimeoutMs}.`,
+    );
+  }
+
+  if (errors.length > 0 || timestampSeconds === null || count === null || page === null || timeoutMs === null) {
+    return { ok: false, errors };
+  }
+
+  return {
+    ok: true,
+    value: {
+      remoteJid,
+      anchor: {
+        id: anchorId,
+        remoteJid,
+        fromMe: anchor.fromMe as boolean,
+        timestampSeconds,
+      },
+      count,
+      page,
+      notBeforeTimestamp,
+      notAfterTimestamp,
+      dryRun: input.dryRun === true,
+      timeoutMs,
+    },
+  };
+}
+
+export function unixSecondsFromProtocol(value: unknown): number | null {
+  let numeric: number | null = null;
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    numeric = value;
+  } else if (isPlainObject(value) && typeof value.toNumber === 'function') {
+    const converted = (value.toNumber as () => number)();
+    if (typeof converted === 'number' && Number.isFinite(converted)) {
+      numeric = converted;
+    }
+  }
+  if (numeric === null) {
+    return null;
+  }
+  if (numeric >= MILLISECOND_TIMESTAMP_FLOOR) {
+    numeric = Math.floor(numeric / 1000);
+  }
+  return Math.floor(numeric);
+}
+
+function hasRecoverableBody(message: object | null | undefined): boolean {
+  if (!isPlainObject(message)) {
+    return false;
+  }
+  const keys = Object.keys(message).filter((key) => key !== 'messageContextInfo' && key !== '_evolutionRecovery');
+  return keys.length > 0;
+}
+
+export interface SelectionResult {
+  selected: SelectedRecoveryMessage[];
+  counts: Pick<
+    RecoveryCounts,
+    | 'protocolMessages'
+    | 'acceptedForStorage'
+    | 'duplicates'
+    | 'skippedWithoutBody'
+    | 'filteredByWindow'
+    | 'ignoredOtherChat'
+    | 'newerOrEqualToAnchor'
+  >;
+}
+
+export function selectRecoverableMessages(
+  messages: InboundRecoveryMessage[] | undefined,
+  record: Pick<RecoveryRecord, 'remoteJid' | 'anchor' | 'notBeforeTimestamp' | 'notAfterTimestamp'>,
+): SelectionResult {
+  const counts = {
+    protocolMessages: messages?.length ?? 0,
+    acceptedForStorage: 0,
+    duplicates: 0,
+    skippedWithoutBody: 0,
+    filteredByWindow: 0,
+    ignoredOtherChat: 0,
+    newerOrEqualToAnchor: 0,
+  };
+  const selected: SelectedRecoveryMessage[] = [];
+  const seen = new Set<string>();
+
+  for (const raw of messages ?? []) {
+    const remoteJid = typeof raw?.key?.remoteJid === 'string' ? raw.key.remoteJid : '';
+    if (remoteJid !== record.remoteJid) {
+      counts.ignoredOtherChat += 1;
+      continue;
+    }
+    const id = typeof raw?.key?.id === 'string' ? raw.key.id : '';
+    if (!MESSAGE_ID_PATTERN.test(id) || typeof raw?.key?.fromMe !== 'boolean') {
+      counts.skippedWithoutBody += 1;
+      continue;
+    }
+    if (!hasRecoverableBody(raw.message)) {
+      counts.skippedWithoutBody += 1;
+      continue;
+    }
+    const timestampSeconds = unixSecondsFromProtocol(raw.messageTimestamp);
+    if (timestampSeconds === null) {
+      counts.skippedWithoutBody += 1;
+      continue;
+    }
+    if (timestampSeconds >= record.anchor.timestampSeconds || id === record.anchor.id) {
+      counts.newerOrEqualToAnchor += 1;
+      continue;
+    }
+    if (record.notBeforeTimestamp !== undefined && timestampSeconds < record.notBeforeTimestamp) {
+      counts.filteredByWindow += 1;
+      continue;
+    }
+    if (record.notAfterTimestamp !== undefined && timestampSeconds > record.notAfterTimestamp) {
+      counts.filteredByWindow += 1;
+      continue;
+    }
+    const identity = `${remoteJid}\u0000${id}`;
+    if (seen.has(identity)) {
+      counts.duplicates += 1;
+      continue;
+    }
+    seen.add(identity);
+    const participant = typeof raw.key?.participant === 'string' ? raw.key.participant : undefined;
+    selected.push({
+      id,
+      remoteJid,
+      fromMe: raw.key.fromMe,
+      participant,
+      timestampSeconds,
+      pushName: typeof raw.pushName === 'string' ? raw.pushName : undefined,
+      raw,
+    });
+  }
+
+  counts.acceptedForStorage = selected.length;
+  return { selected, counts };
+}
+
+export function buildProvenance(record: RecoveryRecord, recoveredAtMs: number): RecoveryProvenance {
+  return {
+    provenance: HISTORY_RECOVERY_PROVENANCE,
+    requestId: record.requestId,
+    peerDataRequestSessionId: record.peerDataRequestSessionId,
+    direction: 'older-than-anchor',
+    anchorMessageId: record.anchor.id,
+    anchorFromMe: record.anchor.fromMe,
+    anchorTimestampSeconds: record.anchor.timestampSeconds,
+    syncType: 'ON_DEMAND',
+    recoveredAt: new Date(recoveredAtMs).toISOString(),
+  };
+}
+
+export function toStoredRecoveryRow(
+  selected: SelectedRecoveryMessage,
+  normalizedMessage: Record<string, unknown>,
+  extras: {
+    provenance: RecoveryProvenance;
+    instanceId: string;
+    messageType: string;
+    contextInfo?: unknown;
+    source?: string;
+    pushName?: string | null;
+  },
+): StoredRecoveryRow {
+  const message = { ...normalizedMessage, _evolutionRecovery: extras.provenance };
+  const row: StoredRecoveryRow = {
+    key: {
+      id: selected.id,
+      remoteJid: selected.remoteJid,
+      fromMe: selected.fromMe,
+      ...(selected.participant ? { participant: selected.participant } : {}),
+    },
+    pushName: extras.pushName ?? selected.pushName ?? null,
+    status: HISTORY_RECOVERY_STORED_STATUS,
+    message,
+    messageType: extras.messageType || 'unknown',
+    messageTimestamp: selected.timestampSeconds,
+    instanceId: extras.instanceId,
+    source: extras.source || 'unknown',
+  };
+  if (extras.contextInfo !== undefined) {
+    row.contextInfo = extras.contextInfo;
+  }
+  return row;
+}
+
+export function addCounts(target: RecoveryCounts, extra: Partial<RecoveryCounts>): void {
+  (Object.keys(extra) as Array<keyof RecoveryCounts>).forEach((key) => {
+    target[key] += extra[key] ?? 0;
+  });
+}
diff --git a/src/api/services/history-recovery/history-recovery.runtime.ts b/src/api/services/history-recovery/history-recovery.runtime.ts
new file mode 100644
index 00000000..6ca1052a
--- /dev/null
+++ b/src/api/services/history-recovery/history-recovery.runtime.ts
@@ -0,0 +1,268 @@
+import { HISTORY_RECOVERY_STORED_STATUS } from './history-recovery.constants';
+import {
+  applyBaileysEventRouting,
+  HistoryRecoveryCoordinator,
+  safeProtocolError,
+} from './history-recovery.coordinator';
+import { toStoredRecoveryRow } from './history-recovery.policy';
+import {
+  InboundRecoveryMessage,
+  NormalizedStoredMessage,
+  PublicRecoveryView,
+  RecoveryBatch,
+  RecoveryRequestInput,
+  StoredRecoveryRow,
+} from './history-recovery.types';
+
+export interface HistoryRecoveryDeps {
+  connectionState: () => string | undefined;
+  fetchMessageHistory: (
+    count: number,
+    key: { remoteJid: string; fromMe: boolean; id: string },
+    oldestMsgTimestampMs: number,
+  ) => Promise<unknown>;
+  normalize: (message: InboundRecoveryMessage) => NormalizedStoredMessage | null;
+  findExistingIds: (ids: string[], remoteJid: string) => Promise<Set<string>>;
+  insertRows: (rows: StoredRecoveryRow[]) => Promise<void>;
+  persistenceEnabled: () => boolean;
+  schedule?: (fn: () => void, ms: number) => { cancel: () => void };
+  now?: () => number;
+  logger?: { info: (value: string) => void; error: (value: string) => void };
+}
+
+function defaultSchedule(fn: () => void, ms: number): { cancel: () => void } {
+  const timer = setTimeout(fn, ms);
+  return { cancel: () => clearTimeout(timer) };
+}
+
+export class HistoryRecoveryRuntime {
+  private readonly coordinator: HistoryRecoveryCoordinator;
+  private readonly timers = new Map<string, { cancel: () => void }>();
+
+  constructor(private readonly deps: HistoryRecoveryDeps) {
+    this.coordinator = new HistoryRecoveryCoordinator();
+  }
+
+  public async request(input: RecoveryRequestInput): Promise<PublicRecoveryView> {
+    const now = this.clock();
+    const prepared = this.coordinator.prepare(input, now);
+    if (prepared.ok === false) {
+      return prepared.view;
+    }
+    const record = prepared.record;
+    if (record.dryRun) {
+      this.log(record.requestId, 'dry-run');
+      return this.coordinator.toPublic(record);
+    }
+    if (this.deps.connectionState() !== 'open') {
+      this.coordinator.abort(
+        record.requestId,
+        'unavailable',
+        503,
+        'O socket Baileys não está aberto. Nenhuma reconexão, logout ou syncFullHistory foi alterado.',
+        now,
+      );
+      this.log(record.requestId, 'unavailable');
+      return this.coordinator.toPublic(this.coordinator.get(record.requestId, now)!);
+    }
+
+    try {
+      const sessionId = await this.deps.fetchMessageHistory(
+        record.count,
+        {
+          remoteJid: record.remoteJid,
+          fromMe: record.anchor.fromMe,
+          id: record.anchor.id,
+        },
+        record.anchor.timestampSeconds * 1000,
+      );
+      const normalizedSession = sessionId === undefined || sessionId === null ? '' : String(sessionId);
+      if (!normalizedSession) {
+        throw new Error('fetchMessageHistory não retornou identificador de sessão.');
+      }
+      const submittedAt = this.clock();
+      this.coordinator.markSubmitted(record.requestId, normalizedSession, submittedAt);
+      this.armTimer(record.requestId, record.timeoutMs);
+      this.log(record.requestId, 'accepted');
+      return this.coordinator.toPublic(this.coordinator.get(record.requestId, submittedAt)!);
+    } catch (error) {
+      this.coordinator.abort(record.requestId, 'unavailable', 503, safeProtocolError(error), this.clock());
+      this.log(record.requestId, 'unavailable');
+      return this.coordinator.toPublic(this.coordinator.get(record.requestId, this.clock())!);
+    }
+  }
+
+  public status(requestId: string): PublicRecoveryView | { status: 'rejected'; httpStatus: number; error: string } {
+    if (!requestId) {
+      return { status: 'rejected', httpStatus: 400, error: 'requestId é obrigatório.' };
+    }
+    const record = this.coordinator.get(requestId, this.clock());
+    if (!record) {
+      return { status: 'rejected', httpStatus: 404, error: 'Recuperação não encontrada neste processo.' };
+    }
+    return this.coordinator.toPublic(record);
+  }
+
+  public async planAndApply(
+    events: { historySet?: any; upsert?: any },
+    handlers: {
+      passthroughHistory: (payload: any) => Promise<void>;
+      liveUpsert: (payload: { messages: any[]; type?: unknown; requestId?: unknown }) => Promise<void>;
+    },
+  ): Promise<void> {
+    const plan = this.coordinator.planEvents(events, this.clock());
+    if (plan.recoveryBatches.length > 0) {
+      for (const batch of plan.recoveryBatches) {
+        this.disarm(batch.requestId);
+      }
+    }
+    await applyBaileysEventRouting(plan, {
+      passthroughHistory: handlers.passthroughHistory,
+      liveUpsert: handlers.liveUpsert,
+      persistRecovery: (batch) => this.persistBatch(batch),
+      onRecoveryError: (error) =>
+        this.deps.logger?.error(`history-recovery persist failed: ${safeProtocolError(error)}`),
+    });
+  }
+
+  public async persistBatch(batch: RecoveryBatch): Promise<void> {
+    const now = this.clock();
+    if (!this.deps.persistenceEnabled()) {
+      this.coordinator.notePersistence(
+        batch.requestId,
+        { persisted: 0, duplicates: 0, skippedWithoutBody: 0, persistenceDisabled: true },
+        now,
+      );
+      this.log(batch.requestId, 'persistence-disabled');
+      return;
+    }
+
+    const rows: StoredRecoveryRow[] = [];
+    let skippedWithoutBody = 0;
+    for (const selected of batch.messages) {
+      let normalized: NormalizedStoredMessage | null = null;
+      try {
+        normalized = this.deps.normalize(selected.raw);
+      } catch {
+        normalized = null;
+      }
+      if (!normalized?.message || Object.keys(normalized.message).length === 0) {
+        skippedWithoutBody += 1;
+        continue;
+      }
+      rows.push(
+        toStoredRecoveryRow(selected, normalized.message, {
+          provenance: batch.provenance,
+          instanceId: normalized.instanceId,
+          messageType: normalized.messageType,
+          contextInfo: normalized.contextInfo,
+          source: normalized.source,
+          pushName: normalized.pushName,
+        }),
+      );
+    }
+
+    if (rows.length === 0) {
+      this.coordinator.notePersistence(
+        batch.requestId,
+        { persisted: 0, duplicates: 0, skippedWithoutBody, persistenceDisabled: false },
+        now,
+      );
+      return;
+    }
+
+    let existing: Set<string>;
+    try {
+      existing = await this.deps.findExistingIds(
+        rows.map((row) => row.key.id),
+        rows[0].key.remoteJid,
+      );
+    } catch (error) {
+      this.coordinator.notePersistence(
+        batch.requestId,
+        {
+          persisted: 0,
+          duplicates: 0,
+          skippedWithoutBody,
+          persistenceDisabled: false,
+          error: safeProtocolError(error),
+        },
+        now,
+      );
+      return;
+    }
+
+    const fresh = rows.filter((row) => !existing.has(row.key.id));
+    const duplicates = rows.length - fresh.length;
+    if (fresh.some((row) => row.status !== HISTORY_RECOVERY_STORED_STATUS)) {
+      this.coordinator.notePersistence(
+        batch.requestId,
+        {
+          persisted: 0,
+          duplicates,
+          skippedWithoutBody,
+          persistenceDisabled: false,
+          error: 'Linha recuperada sem status HISTORY foi recusada.',
+        },
+        now,
+      );
+      return;
+    }
+    if (fresh.length > 0) {
+      try {
+        await this.deps.insertRows(fresh);
+      } catch (error) {
+        this.coordinator.notePersistence(
+          batch.requestId,
+          {
+            persisted: 0,
+            duplicates,
+            skippedWithoutBody,
+            persistenceDisabled: false,
+            error: safeProtocolError(error),
+          },
+          now,
+        );
+        return;
+      }
+    }
+    this.coordinator.notePersistence(
+      batch.requestId,
+      { persisted: fresh.length, duplicates, skippedWithoutBody, persistenceDisabled: false },
+      now,
+    );
+    this.log(batch.requestId, 'persisted');
+  }
+
+  public audit() {
+    return this.coordinator.auditEntries();
+  }
+
+  private armTimer(requestId: string, timeoutMs: number): void {
+    const schedule = this.deps.schedule ?? defaultSchedule;
+    const timer = schedule(() => {
+      this.timers.delete(requestId);
+      this.coordinator.expire(this.clock());
+      this.log(requestId, 'timeout-check');
+    }, timeoutMs);
+    this.timers.set(requestId, timer);
+  }
+
+  private disarm(requestId: string): void {
+    const timer = this.timers.get(requestId);
+    if (timer) {
+      timer.cancel();
+      this.timers.delete(requestId);
+    }
+  }
+
+  private clock(): number {
+    return this.deps.now ? this.deps.now() : Date.now();
+  }
+
+  private log(requestId: string, status: string): void {
+    this.deps.logger?.info(`history-recovery requestId=${requestId} status=${status}`);
+  }
+}
+
+export { applyBaileysEventRouting };
